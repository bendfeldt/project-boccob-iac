variable "namespace" {
  description = "Namespace (convention: catalog; needs secrets_access = true and the platform-ca ConfigMap)."
  type        = string
}

variable "chart" {
  description = "Polaris chart (module.versions.charts[\"polaris\"])."
  type = object({
    repository = string
    name       = string
    version    = string
  })
}

variable "images" {
  description = "Images from module.versions.images: polaris, admin_tool (polaris-admin-tool), postgres (psql for the schema init), python (provisioning Job)."
  type        = map(any)
}

variable "replicas" {
  description = "Polaris pods. All state is in PostgreSQL, so any number of replicas can serve; >1 adds a PodDisruptionBudget and topology spread."
  type        = number
  default     = 1
}

variable "resources" {
  description = "Polaris container resources."
  type = object({
    requests = map(string)
    limits   = map(string)
  })
  default = {
    requests = { cpu = "50m", memory = "448Mi" }
    limits   = { memory = "768Mi" }
  }
}

variable "realm" {
  description = "Polaris realm."
  type        = string
  default     = "POLARIS"
}

variable "database" {
  description = "PostgreSQL metastore. `kv_path`: OpenBao KV path with username / password / dbname (modules/postgres-cluster output kv_path)."
  type = object({
    host    = string
    port    = optional(number, 5432)
    kv_path = string
    schema  = optional(string, "polaris_schema")
  })
}

variable "s3" {
  description = "Object storage used by the catalogs. `credentials_kv_path`: OpenBao KV path with access-key / secret-key of the S3 user Polaris itself uses (metadata files, purge)."
  type = object({
    endpoint            = string
    region              = string
    credentials_kv_path = string
  })
}

variable "catalogs" {
  description = "Internal catalogs (name => settings). `properties` are catalog properties, e.g. polaris.config.drop-with-purge.enabled."
  type = map(object({
    base_location     = string
    allowed_locations = list(string)
    properties        = optional(map(string), {})
  }))
  default = {}
}

variable "principals" {
  description = <<-EOT
    Service principals (name => catalog => catalog privileges). For each principal a
    principal role (same name) and a catalog role `<name>_access` per catalog are
    created; privileges that are not listed are revoked from that catalog role.
    Credentials are generated by Polaris and stored in OpenBao at
    kv/<kv_prefix>/principals/<name> (client-id, client-secret, credential, scope).
  EOT
  type = map(object({
    catalog_privileges = map(list(string))
  }))
  default = {}
}

variable "kv_prefix" {
  description = "OpenBao KV v2 path prefix (without mount) for everything this module stores."
  type        = string
  default     = "catalog/polaris"
}

variable "openbao" {
  description = "OpenBao access of the provisioning Job (kubernetes auth)."
  type = object({
    url          = string
    kv_mount     = optional(string, "kv")
    auth_backend = optional(string, "kubernetes")
  })
}

variable "oidc" {
  description = <<-EOT
    Optional external identity provider (Keycloak) in addition to Polaris' own
    principals: switches authentication to `mixed`. null = `internal` only.
    `client_secret_kv_path`: OpenBao KV path with property client-secret.
  EOT
  type = object({
    issuer                = string
    client_id             = string
    client_secret_kv_path = string
    principal_name_claim  = optional(string, "preferred_username")
    roles_claim           = optional(string, "groups")
  })
  default = null
}

variable "features" {
  description = "Extra Polaris feature flags (polaris.features.*), merged over the module defaults."
  type        = map(any)
  default     = {}
}

variable "json_logs" {
  description = "JSON console logs (for the central log pipeline)."
  type        = bool
  default     = true
}

variable "service_monitor" {
  description = "Create a ServiceMonitor (needs the Prometheus operator CRDs — enabled by the ops stack)."
  type        = bool
  default     = false
}

variable "cluster_issuer" {
  description = "cert-manager ClusterIssuer for the server certificate."
  type        = string
  default     = "openbao-pki"
}

variable "ca_configmap" {
  description = "ConfigMap in the namespace with the platform CA bundle (key ca.crt)."
  type        = string
  default     = "platform-ca"
}

variable "ca_bundle_pem" {
  description = "PEM content of the platform CA bundle (for the JVM trust store)."
  type        = string
}

variable "labels" {
  description = "Labels for the created objects."
  type        = map(string)
  default     = {}
}

variable "secret_stores" {
  description = "External Secrets stores for this module's secrets: { read, push, kind }. Pass module.ns_<x>.secret_stores (the namespace's own SecretStores, kv/<ns>/* + granted reads, stack 11 namespace_secret_stores); the default is the legacy cluster-wide stores."
  type = object({
    read = string
    push = string
    kind = string
  })
  default = { read = "openbao", push = "openbao-push", kind = "ClusterSecretStore" }
}
